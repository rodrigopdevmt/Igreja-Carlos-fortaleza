# ==========================================
# CONFIGURAÇÃO DE AMBIENTE - IGREJA APOSTÓLICA BOAS NOVAS
# ==========================================

# GEMINI_API_KEY: Requerido para assistente pastoral inteligente e transcrições
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base da aplicação
APP_URL="MY_APP_URL"

# ==========================================
# BANCO DE DADOS NA VPS (POSTGRESQL / MYSQL / POSTGREST)
# ==========================================
# String de Conexão Direta (PostgreSQL na VPS):
DATABASE_URL="postgresql://boasnovas_user:sua_senha_segura@seu_ip_vps_ou_dominio:5432/boas_novas_db?sslmode=prefer"

# Parâmetros Individuais do Banco de Dados na VPS:
VPS_DB_HOST="seu_ip_vps_ou_dominio"
VPS_DB_PORT="5432"
VPS_DB_NAME="boas_novas_db"
VPS_DB_USER="boasnovas_user"
VPS_DB_PASSWORD="sua_senha_segura"
VPS_DB_SSL="prefer"

# API Backend / PostgREST na VPS (Opcional se utilizar API REST intermediária):
VITE_API_URL="https://api.boasnovas.org.br"
VITE_VPS_HOST="192.168.1.100"
