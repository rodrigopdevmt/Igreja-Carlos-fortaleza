{
  "framework": "vite",
  "buildCommand": "VITE_API_URL=https://celebrities-locations-shirts-analyst.trycloudflare.com/rest npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.igrejaboasnovas.online" }],
      "destination": "/painel/dashboard",
      "permanent": false
    }
  ]
}
